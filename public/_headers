# Blink Hosting owns response headers at the edge. This manifest documents the
# intended policy for hosting layers that honor project header manifests.
/*
  Content-Type: text/html; charset=utf-8
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://blink.new https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.blink.new https://*.blink-apis.com https://www.google-analytics.com https://www.googletagmanager.com; frame-src 'self' https://client.crisp.chat; Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=(self); Referrer-Policy: strict-origin-when-cross-origin

# Cache static assets aggressively
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache HTML pages with revalidation
/*.html
  Cache-Control: public, max-age=0, must-revalidate